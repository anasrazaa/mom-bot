# ── LLM ──────────────────────────────────────────────────────────────────────
# Options: qwen2.5:7b | qwen2.5:14b | llama3:8b | mistral:7b
LLM_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://ollama:11434   # use http://localhost:11434 outside Docker

# ── Whisper STT ───────────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3               # large-v2 if VRAM tight
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16         # float32 for CPU fallback
WHISPER_FORCE_ENGLISH=true           # Always output transcript text in English (Urdu/English speech supported)
WHISPER_LOW_CONF_THRESHOLD=-0.85     # Lower avg_logprob is flagged for manual review

# ── Pyannote Diarization ──────────────────────────────────────────────────────
# Required once for initial model download from HuggingFace.
# After download, works fully offline.
# Get token at: https://huggingface.co/settings/tokens
# Accept terms at: https://hf.co/pyannote/speaker-diarization-3.1
PYANNOTE_HF_TOKEN=hf_your_token_here

# ── Audio ─────────────────────────────────────────────────────────────────────
SAMPLE_RATE=16000
CHUNK_DURATION=8.0                   # seconds per processing window

# ── Speaker Identification ────────────────────────────────────────────────────
SPEAKER_ID_THRESHOLD=0.75            # cosine similarity threshold

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
